# These are optional settings read from the process environment.
# The server does not automatically load this file. Do not commit secret values.
HOST=127.0.0.1
PORT=8000
# Persistent PRIVATE storage outside the public/ directory; back up encryption.key with the database.
# FESTIVAL_DATA=/private/persistent/festival-data
# FESTIVAL_PUBLIC_URL=https://festival.example.com
# Enable when serving through a trusted HTTPS reverse proxy:
# FESTIVAL_SECURE_COOKIE=1
# Disable first-account setup when exposing to other machines:
# FESTIVAL_ALLOW_SETUP=0

# Comma-separated exact homepage origins; no wildcard. Enables iframe and read-only public API CORS.
# FESTIVAL_EMBED_ORIGINS=https://your-site.imweb.me,https://festival.example.com
